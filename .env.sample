# Only for Tuyau build processes in frontend
NO_BACKEND_ENV=false

# Node env
NODE_ENV=development

# Server Host, Port and Timezone
HOST=0.0.0.0
PORT=3333
TZ=Europe/Paris

# App name and key (AES-256-CBC generated via `node ace generate:key`)
APP_NAME=Adonis-Boilerplate
APP_KEY=

# The current URL of the application, used for SSO and other features
APP_URL=http://localhost:3333

# The AdonisJS/session store to use at runtime
SESSION_DRIVER=cookie

# PostgreSQL database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Default administrator (optional - for seeding only)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
