{
    "name": "adonis-boilerplate",
    "productName": "AdonisJS Boilerplate",
    "version": "1.7.1",
    "description": "An AdonisJS and Lucid boilerplate integrating authentication, a role system, token scopes and more!",
    "author": "Alien <contact@alien.club> (https://www.alien.club/)",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "type": "module",
    "homepage": "https://github.com/the-alien-club/adonis-boilerplate",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/the-alien-club/adonis-boilerplate.git"
    },
    "bugs": {
        "url": "https://github.com/the-alien-club/adonis-boilerplate/issues"
    },
    "imports": {
        "#config/*": "./config/*.js",
        "#database/*": "./database/*.js",
        "#lib/*": "./lib/*.js",
        "#shared/*": "./shared/*.js",
        "#start/*": "./start/*.js",
        "#tests/*": "./tests/*.js",
        "#types/*": "./types/*.js",
        "#controllers/*": "./app/controllers/*.js",
        "#exceptions/*": "./app/exceptions/*.js",
        "#middleware/*": "./app/middleware/*.js",
        "#models/*": "./app/models/*.js",
        "#policies/*": "./app/policies/*.js",
        "#validators/*": "./app/validators/*.js"
    },
    "exports": {
        "./api": "./.adonisjs/index.ts",
        "./shared": "./shared/index.ts"
    },
    "scripts": {
        "v-bump": "yarn version --patch",
        "migration:fresh": "cross-env NO_LC=true node ace migration:refresh --seed",
        "migration:run": "cross-env NO_LC=true node ace migration:run",
        "db:wipe": "cross-env NO_LC=true node ace db:wipe",
        "db:seed": "cross-env NO_LC=true node ace db:seed",
        "generate:key": "cross-env NO_LC=true node ace generate:key",
        "knip": "knip",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "tuyau:generate": "node ace tuyau:generate",
        "test:sandbox": "dotenv tsx ./tests/sandbox.ts",
        "test:unit": "node ace test unit",
        "dev": "node ace serve --watch",
        "build": "node ace build",
        "start": "node ./bin/server.js"
    },
    "dependencies": {
        "@adonisjs/assembler": "^7.8.2",
        "@adonisjs/auth": "^9.4.2",
        "@adonisjs/bouncer": "^3.1.6",
        "@adonisjs/cache": "^1.3.0",
        "@adonisjs/core": "^6.19.0",
        "@adonisjs/cors": "^2.2.1",
        "@adonisjs/limiter": "^2.4.0",
        "@adonisjs/lucid": "^21.7.0",
        "@adonisjs/session": "^7.5.1",
        "@aws-sdk/client-s3": "^3.846.0",
        "@aws-sdk/s3-request-presigner": "^3.846.0",
        "@langchain/core": "^0.3.63",
        "@langchain/openai": "^0.5.18",
        "@supabase/supabase-js": "^2.50.5",
        "@tuyau/core": "^0.4.2",
        "@tuyau/openapi": "^1.0.2",
        "@types/graphlib": "^2.1.12",
        "@vinejs/vine": "^3.0.1",
        "ajv": "^8.17.1",
        "amqplib": "^0.10.8",
        "cross-env": "^7.0.3",
        "cross-var": "^1.1.0",
        "dedent": "^1.6.0",
        "dotenv": "^17.2.2",
        "dotenv-cli": "^9.0.0",
        "graphlib": "^2.1.8",
        "hot-hook": "^0.4.0",
        "hyparquet": "^1.17.5",
        "ioredis": "^5.6.1",
        "js-yaml": "^4.1.0",
        "json-schema": "^0.4.0",
        "luxon": "^3.7.1",
        "openapi-types": "^12.1.3",
        "pg": "^8.16.3",
        "pino-pretty": "^13.0.0",
        "reflect-metadata": "^0.2.2",
        "slugify": "^1.6.6",
        "ts-node-maintained": "^10.9.5",
        "uuid": "^11.1.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^7.8.2",
        "@adonisjs/eslint-config": "^2.1.0",
        "@adonisjs/prettier-config": "^1.4.5",
        "@adonisjs/tsconfig": "^1.4.1",
        "@japa/api-client": "^3.1.0",
        "@japa/assert": "^4.0.1",
        "@japa/plugin-adonisjs": "^4.0.0",
        "@japa/runner": "^4.2.0",
        "@swc/core": "^1.12.14",
        "@types/amqplib": "^0.10.7",
        "@types/js-yaml": "^4.0.9",
        "@types/json-schema": "^7.0.15",
        "@types/luxon": "^3.6.2",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.31.0",
        "knip": "^5.62.0",
        "openapi-types": "^12.1.3",
        "prettier": "^3.6.2",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    },
    "hotHook": {
        "boundaries": [
            "./app/controllers/**/*.ts",
            "./app/middleware/*.ts"
        ]
    },
    "eslintConfig": {
        "extends": "@adonisjs/eslint-config/app"
    }
}
