{
    "name": "adonis-boilerplate",
    "productName": "AdonisJS Boilerplate",
    "version": "1.6.3-alpha",
    "description": "An AdonisJS boilerplate that integrates a role system, token scopes, cron jobs and more!",
    "author": "Alien <contact@alien.club> (https://www.alien.club/)",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "type": "module",
    "homepage": "https://github.com/the-alien-club/adonis-boilerplate",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/the-alien-club/adonis-boilerplate.git"
    },
    "bugs": {
        "url": "https://github.com/the-alien-club/adonis-boilerplate/issues"
    },
    "scripts": {
        "v-bump": "yarn version --patch",
        "migration:fresh": "cross-env NO_LC=true node ace migration:refresh --seed",
        "migration:run": "cross-env NO_LC=true node ace migration:run",
        "db:wipe": "cross-env NO_LC=true node ace db:wipe",
        "db:seed": "cross-env NO_LC=true node ace db:seed",
        "generate:key": "cross-env NO_LC=true node ace generate:key",
        "knip": "knip",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test:sandbox": "tsx ./tests/sandbox.ts",
        "test:unit": "node ace test unit",
        "dev": "node ace serve --watch",
        "build": "cross-env NO_LC=true node ace build",
        "start": "node bin/server.js"
    },
    "imports": {
        "#config/*": "./config/*.js",
        "#database/*": "./database/*.js",
        "#lib/*": "./lib/*.js",
        "#start/*": "./start/*.js",
        "#tests/*": "./tests/*.js",
        "#types/*": "./types/*.js",
        "#controllers/*": "./app/controllers/*.js",
        "#exceptions/*": "./app/exceptions/*.js",
        "#middleware/*": "./app/middleware/*.js",
        "#models/*": "./app/models/*.js",
        "#policies/*": "./app/policies/*.js",
        "#providers/*": "./app/providers/*.js",
        "#queues/*": "./app/queues/*.js",
        "#validators/*": "./app/validators/*.js",
        "#workers/*": "./app/workers/*.js"
    },
    "dependencies": {
        "@adonisjs/auth": "^9.4.0",
        "@adonisjs/bouncer": "^3.1.6",
        "@adonisjs/core": "^6.18.0",
        "@adonisjs/cors": "^2.2.1",
        "@adonisjs/lucid": "^21.6.1",
        "@vinejs/vine": "^3.0.1",
        "bullmq": "^5.39.2",
        "dedent-js": "^1.0.1",
        "luxon": "^3.6.1",
        "pg": "^8.16.0",
        "reflect-metadata": "^0.2.2",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^7.8.2",
        "@adonisjs/eslint-config": "^2.1.0",
        "@adonisjs/prettier-config": "^1.4.5",
        "@adonisjs/tsconfig": "^1.4.1",
        "@japa/api-client": "^3.1.0",
        "@japa/assert": "^4.0.1",
        "@japa/plugin-adonisjs": "^4.0.0",
        "@japa/runner": "^4.2.0",
        "@swc/core": "^1.11.31",
        "@types/luxon": "^3.6.2",
        "@types/node": "^24.0.0",
        "@types/uuid": "^10.0.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.28.0",
        "hot-hook": "^0.4.0",
        "knip": "^5.60.2",
        "openapi-types": "^12.1.3",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.5.3",
        "ts-node-maintained": "^10.9.5",
        "tsx": "^4.19.4",
        "typescript": "5.7.3"
    },
    "hotHook": {
        "boundaries": [
            "./app/controllers/**/*.ts",
            "./app/middleware/*.ts"
        ]
    },
    "eslintConfig": {
        "extends": "@adonisjs/eslint-config/app"
    }
}